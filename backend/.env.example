DATABASE_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET=change-this-dev-secret-before-any-real-deployment
JWT_EXPIRE_MINUTES=480
# Add your machine's LAN IP (e.g. http://192.168.1.23:3000) so phones on the
# same Wi-Fi can load the site when scanning a table QR code.
CORS_ORIGINS=http://localhost:3000
ENV=development

# Admin login created by `python -m app.seed` — only takes effect the first
# time the restaurant is seeded on an empty DB.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!

# Optional — leave blank to run with cash/card/UPI-at-counter payments only.
# Set both to enable "pay online" from the guest's bill view via Razorpay Checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
