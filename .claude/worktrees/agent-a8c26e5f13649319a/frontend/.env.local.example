# Server-side only — used inside Next.js route handlers (the BFF proxy layer).
API_BASE_URL=http://localhost:8000

# Client-side — used by browser code for direct public calls (guest menu/order/
# reservation flows) and WebSocket connections. Must match the backend's origin.
# For phone/QR testing over Wi-Fi, use your machine's LAN IP instead of
# localhost (find it with `ipconfig` / `Get-NetIPAddress`), and add that same
# origin to backend/.env's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match backend/.env's JWT_SECRET exactly — the frontend verifies the
# session JWT locally (no network round-trip) rather than calling /auth/me.
AUTH_JWT_SECRET=change-this-dev-secret-before-any-real-deployment
