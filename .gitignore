# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
frontend/.next/
frontend/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example
!frontend/.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
frontend/next-env.d.ts

# python / backend
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc
backend/dev.db
backend/*.db
