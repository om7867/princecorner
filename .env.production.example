# ==============================================================================
# Production Environment Configuration — restaurent.kelviontech.in
# Copy this file to .env on your Oracle VM server before deploying
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Credentials (PostgreSQL 16 container)
# ------------------------------------------------------------------------------
POSTGRES_DB=restaurant_db
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=SetAStrongRandomPassword2026!

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secret
# Generate a strong 64-character secret using: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=ReplaceWith64CharacterHexSecretForProduction2026!

# ------------------------------------------------------------------------------
# 3. Domain & Public Access Settings
# ------------------------------------------------------------------------------
DOMAIN=restaurent.kelviontech.in
PUBLIC_URL=https://restaurent.kelviontech.in
CORS_ORIGINS=https://restaurent.kelviontech.in

# ------------------------------------------------------------------------------
# 4. Optional Payments Integration (Razorpay Checkout)
# Leave blank to use Cash / Card / UPI counter billing only
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. Initial Admin Credentials (Dev/Seed defaults — CHANGE BEFORE PRODUCTION)
# ------------------------------------------------------------------------------
SEED_OWNER_EMAIL=owner@kelviontech.in
SEED_OWNER_PASSWORD=ChangeMeProduction123!
